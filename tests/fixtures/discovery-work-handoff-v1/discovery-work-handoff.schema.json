{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business discovery handoff v1",
  "$defs": {
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "actionId": {
      "enum": [
        "goal",
        "migration",
        "domain-access",
        "domain",
        "domain-discovery",
        "website-discovery",
        "discover-registration",
        "registration",
        "ein",
        "offer",
        "tools"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "discoveryRevision",
        "answerRevision",
        "planRevision",
        "actionId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "discoveryRevision": {
          "$ref": "#/$defs/revision"
        },
        "answerRevision": {
          "$ref": "#/$defs/revision"
        },
        "planRevision": {
          "$ref": "#/$defs/revision"
        },
        "actionId": {
          "$ref": "#/$defs/actionId"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "taskId"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/actionId"
        },
        "taskId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "receiptId",
        "taskVersion"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/identifier"
        },
        "receiptId": {
          "$ref": "#/$defs/identifier"
        },
        "taskVersion": {
          "const": 1
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "orgId",
        "handoffId",
        "projectId",
        "actionId",
        "discoveryRevision",
        "answerRevision",
        "planRevision",
        "dependencies",
        "state",
        "approvalId",
        "effectVersion",
        "payloadHash",
        "task",
        "lineageStatus",
        "supersedesHandoffId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "orgId": {
          "$ref": "#/$defs/identifier"
        },
        "handoffId": {
          "$ref": "#/$defs/identifier"
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "actionId": {
          "$ref": "#/$defs/actionId"
        },
        "discoveryRevision": {
          "$ref": "#/$defs/revision"
        },
        "answerRevision": {
          "$ref": "#/$defs/revision"
        },
        "planRevision": {
          "$ref": "#/$defs/revision"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "state": {
          "enum": [
            "waiting_approval",
            "queued",
            "confirmed",
            "failed",
            "canceled"
          ]
        },
        "approvalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectVersion": {
          "$ref": "#/$defs/revision"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/task"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineageStatus": {
          "enum": [
            "current",
            "superseded"
          ]
        },
        "supersedesHandoffId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "task": {
                "$ref": "#/$defs/task"
              }
            }
          },
          "else": {
            "properties": {
              "task": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "waiting_approval"
              }
            }
          },
          "then": {
            "properties": {
              "approvalId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "orgId",
        "handoffs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "orgId": {
          "$ref": "#/$defs/identifier"
        },
        "handoffs": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/handoff"
          }
        }
      }
    }
  }
}
